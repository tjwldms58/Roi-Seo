<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<title>{{ document.title }}</title>
<style>
@font-face { font-family: "ReportKR"; src: url("assets/fonts/NotoSansKR-Regular.otf"); font-weight: 400; }
@font-face { font-family: "ReportKR"; src: url("assets/fonts/NotoSansKR-Bold.otf"); font-weight: 700; }
@page {
  size: A4;
  margin: 13mm 14mm 14mm 14mm;
  background: #f0f0e8;
  @bottom-left {
    content: "{{ document.footer_note }}  ·  로직 {{ version }}";
    font-family: "ReportKR", sans-serif; font-size: 8pt; color: #6d7874;
  }
  @bottom-right {
    content: counter(page);
    font-family: "ReportKR", sans-serif; font-size: 8pt; color: #6d7874;
  }
}
@page cover {
  margin: 16mm 16mm 14mm 16mm;
  background: #103840;
  @bottom-left {
    content: "{{ document.footer_note }}";
    font-family: "ReportKR", sans-serif; font-size: 8pt; color: #8aa4a8;
  }
  @bottom-right {
    content: counter(page);
    font-family: "ReportKR", sans-serif; font-size: 8pt; color: #8aa4a8;
  }
}
* { box-sizing: border-box; }
body { margin: 0; font-family: "ReportKR", sans-serif; color: #183038; font-size: 10pt; line-height: 1.55; background: #f0f0e8; }
.cover { page: cover; color: #f4f1ea; min-height: 250mm; }
.sheet-foot { display: none; }
@media print {
  .sheet-inner { zoom: 1 !important; }
  .sheet-foot { display: none !important; }
}
@media screen {
  body { background: #d9d4c8; margin: 0; padding: 8mm 0 12mm; min-width: 210mm; }
  .cover, .page {
    width: 210mm;
    height: 297mm;
    min-height: 297mm;
    max-height: 297mm;
    margin: 8mm auto 0;
    overflow: hidden;
    position: relative;
    box-shadow: 0 8px 22px rgba(24, 40, 48, 0.14);
    break-before: auto;
  }
  .cover { background: #103840; padding: 16mm 16mm 16mm; }
  .page { background: #f0f0e8; padding: 13mm 14mm 16mm; }
  .sheet-foot {
    display: block;
    position: absolute;
    left: 14mm;
    right: 14mm;
    bottom: 6mm;
    font-size: 8pt;
    color: #6d7874;
  }
  .cover .sheet-foot { color: #8aa4a8; }
}
.brand { margin: 0; letter-spacing: 0.22em; font-size: 11pt; color: #d7e4e2; }
.cover h1 { margin: 28mm 0 0; font-size: 28pt; line-height: 1.28; font-weight: 700; }
.rule { width: 28mm; height: 2px; background: #a84838; margin: 8mm 0; }
.who { margin: 0; font-size: 14pt; }
.meta { margin: 3mm 0 0; color: #c5d5d2; }
.cover-line { margin-top: 16mm; max-width: 155mm; font-size: 12pt; line-height: 1.6; color: #e7eeec; }
.page { break-before: page; }
.top { width: 100%; border-bottom: 0.6pt solid #d5d3c8; padding-bottom: 2mm; margin-bottom: 6mm; }
.top td { font-size: 8pt; letter-spacing: 0.14em; color: #5e6c68; }
.top .right { text-align: right; letter-spacing: 0.04em; }
.kicker { margin: 0; color: #a84838; font-size: 8.5pt; letter-spacing: 0.08em; }
h2 { margin: 1mm 0 4mm; font-size: 18pt; line-height: 1.3; color: #143840; }
.cards { width: 100%; border-collapse: separate; border-spacing: 3mm 0; margin: 2mm 0 4mm -3mm; }
.cards td { background: #fff; border-top: 3px solid #1d4f4c; padding: 3.5mm; width: 25%; vertical-align: top; }
.n { margin: 0; font-size: 14pt; font-weight: 700; color: #143840; }
.l { margin: 1mm 0 0; font-size: 8.5pt; color: #5c6a66; }
.sub { margin: 0; font-size: 8pt; color: #6a7672; }
.note { background: #d8e8e0; padding: 4mm; margin: 3mm 0; }
.warm { background: #f0e0d8; padding: 4mm; margin: 3mm 0; }
.box-label { margin: 0 0 2mm; font-size: 8pt; letter-spacing: 0.12em; color: #5c5048; }
.session { border-left: 3px solid #1d4f4c; background: #fff; padding: 3mm 4mm; margin: 0 0 3mm; }
.session h3 { margin: 0; font-size: 11pt; }
.chip { display: inline-block; border: 1px solid #a84838; color: #a84838; padding: 0 2mm; margin-right: 2mm; font-size: 8pt; }
.cap { width: 100%; border-collapse: collapse; margin: 0 0 3mm; background: #fff; }
.cap td { padding: 3mm 4mm; vertical-align: top; }
.cap .before, .cap .after { width: 32%; }
.before { background: #f4f1ea; }
.after { background: #d8e8e0; }
.grid { width: 100%; border-collapse: collapse; background: #fff; margin: 2mm 0 4mm; }
.grid th, .grid td { border-bottom: 0.4pt solid #e0ddd2; text-align: left; padding: 2mm 2.5mm; vertical-align: top; font-size: 9pt; }
.grid th { color: #6a7672; font-weight: 400; font-size: 8pt; }
.delta { color: #a84838; font-weight: 700; }
.cols td { width: 33%; background: #fff; vertical-align: top; padding: 4mm; border-top: 3px solid #a84838; }
.cols { width: 100%; border-collapse: separate; border-spacing: 3mm 0; margin-left: -3mm; }
.cols ul { margin: 2mm 0 0; padding-left: 4mm; }
.nurse { background: #103840; color: #f4f1ea; padding: 5mm; margin-top: 4mm; }
.nurse .who { font-size: 11pt; margin: 0 0 2mm; }
.missing { color: #8a8175; }
.fine { color: #5c6a66; font-size: 9pt; }
</style>
</head>
<body data-brand="{{ document.brand }}" data-note="{{ document.footer_note }}" data-version="{{ version }}" data-cover-foot="{{ document.footer_note }}">
{% macro txt(value, blank) -%}
{%- if value -%}{{ value }}{%- elif blank -%}<span class="missing">{{ content.missing_text }}</span>{%- endif -%}
{%- endmacro %}
{% macro lines(value) -%}
<ul>{% for line in (value or "").split("\n") if line.strip() %}<li>{{ line.strip() }}</li>{% endfor %}</ul>
{%- endmacro %}

{% for section in sections %}
{% if section.id == "cover" %}
<header class="cover">
  <p class="brand">{{ document.brand }}</p>
  <h1>{{ document.title }}</h1>
  <div class="rule"></div>
  <p class="who">{{ txt(content.name, section.show_blank) }}</p>
  <p class="meta">{{ txt(content.cancer_type, section.show_blank) }}</p>
  <p class="meta">{{ txt(content.date_range, section.show_blank) }} · {{ txt(content.visit_count, true) }} · 발행 {{ txt(content.issued_on, section.show_blank) }}</p>
  {% if content.summary_narrative %}<p class="cover-line">{{ content.summary_narrative.split("습니다.")[0] }}{% if "습니다." in content.summary_narrative %}습니다.{% endif %}</p>{% endif %}
</header>

{% elif section.id == "summary" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">SUMMARY</p>
  <h2>이런 변화가 있었어요</h2>
  <table class="cards"><tr>
    {% for stat in content.summary_stats %}
    <td><p class="n">{{ txt(stat.value, section.show_blank) }}</p><p class="l">{{ stat.label }}</p><p class="sub">{{ stat.sub }}</p></td>
    {% endfor %}
  </tr></table>
  <div class="note"><p class="box-label">요약</p><p>{{ txt(content.summary_narrative, section.show_blank) }}</p></div>
  <p class="kicker">PRACTICE</p>
  <h2>이렇게 실천했어요</h2>
  <table class="grid">
    {% for row in content.practice_rows %}
    <tr><td>{{ row.group }}</td><td><strong>{{ txt(row.value, section.show_blank) }}</strong></td><td>{{ row.label }}</td></tr>
    {% endfor %}
  </table>
  <p>{{ txt(content.practice_narrative, section.show_blank) }}</p>
  <table class="cards"><tr>
    {% for stat in content.care_stats %}
    <td><p class="n">{{ txt(stat.value, section.show_blank) }}</p><p class="l">{{ stat.label }}</p></td>
    {% endfor %}
  </tr></table>
  <div class="warm"><p class="box-label">이렇게 관리해드렸어요</p><p>{{ txt(content.care_narrative, section.show_blank) }}</p></div>
  {% if content.professor %}<div class="note"><p>{{ content.professor }}</p></div>{% endif %}
  {% if content.next_plan %}<p>{{ content.next_plan }}</p>{% endif %}
  {% if content.next_chips %}<p>{% for chip in content.next_chips.replace("·", "\n").split("\n") if chip.strip() %}<span class="chip">{{ chip.strip() }}</span>{% endfor %}</p>{% endif %}
</section>

{% elif section.id == "sessions" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">SESSIONS</p>
  <h2>회차별 실천 기록</h2>
  {% for row in content.sessions %}
  <div class="session">
    <p class="kicker">{{ row.no }}회차 · {{ row.date }}{% if row.tag %} · {{ row.tag }}{% endif %}</p>
    <h3>{{ txt(row.title, section.show_blank) }}</h3>
    <p>{{ txt(row.desc, section.show_blank) }}</p>
    {% if row.note_text %}<p><span class="chip">{{ row.note_type or "메모" }}</span>{{ row.note_text }}</p>{% endif %}
  </div>
  {% endfor %}
  <p class="fine">{{ content.session_note }}</p>
</section>

{% elif section.id == "capability" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">CAPABILITY</p>
  <h2>운동별 체력 변화</h2>
  {% for row in content.capabilities %}
  <table class="cap">
    <tr><td colspan="2"><strong>{{ row.name }}</strong></td></tr>
    <tr>
      <td class="before"><p class="l">이전</p><p>{{ txt(row.before, section.show_blank) }}</p></td>
      <td class="after"><p class="l">이후</p><p>{{ txt(row.after, section.show_blank) }}</p></td>
    </tr>
    {% if row.note %}<tr><td colspan="2">{{ row.note }}</td></tr>{% endif %}
  </table>
  {% endfor %}
  {% if content.capability_quote %}<div class="warm"><p>{{ content.capability_quote }}</p></div>{% endif %}
</section>

{% elif section.id == "functional" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">FUNCTION</p>
  <h2>수행 지표로 확인한 변화</h2>
  {% if content.learned %}
  <p class="fine">{{ content.learned_badge }}</p>
  <table class="grid">
    {% for row in content.learned %}<tr><td>{{ row.label }}</td><td>{{ row.range }}</td></tr>{% endfor %}
  </table>
  {% elif section.show_blank %}<p class="missing">{{ content.missing_text }}</p>{% endif %}
  <p class="kicker">SPPB {{ content.sppb_total }}</p>
  <p class="fine">{{ content.sppb_badge }}</p>
  {% if content.sppb_headline %}<p class="n">{{ content.sppb_headline }}</p>{% endif %}
  <table class="grid">
    <tr><th>항목</th><th>첫 검사</th><th>재검사</th><th>메모</th></tr>
    {% for row in content.sppb %}
    <tr><td>{{ row.label }}<div class="fine">{{ row.caption }}</div></td><td>{{ row.first }}{{ row.unit }}</td><td>{{ row.last }}{{ row.unit }}</td><td>{{ row.note }}</td></tr>
    {% endfor %}
  </table>
  <div class="note"><p>{{ content.sppb_detail }}</p></div>
  <p class="kicker">WEIGHT</p>
  {% if content.weight %}
  <p class="n">{{ content.weight.first }}{{ content.weight.unit }} → {{ content.weight.last }}{{ content.weight.unit }} <span class="delta">{{ content.weight.delta }}</span></p>
  {% elif section.show_blank %}<p class="missing">{{ content.missing_text }}</p>{% endif %}
  <p>{{ content.weight_note }}</p>
  <p class="fine">BMI {{ content.bmi_text }}</p>
</section>

{% elif section.id == "cancer" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">{{ content.cancer_type_metric or content.cancer_type }}</p>
  <h2>암종별 특화 지표</h2>
  {% if content.arm_rows %}
  <p class="n">{{ content.arm_delta }} <span class="fine">{{ content.arm_badge }}</span></p>
  <table class="grid">
    {% for row in content.arm_rows %}<tr><td>{{ row.label }}</td><td>{{ row.value }} cm</td></tr>{% endfor %}
  </table>
  <div class="note"><p>{{ content.arm_interp }}</p></div>
  <table class="cards"><tr>
    {% if content.volume %}<td><p class="l">{{ content.volume.label }}</p><p class="n">{{ content.volume.delta }}</p><p class="sub">{{ content.volume.first }} → {{ content.volume.last }} {{ content.volume.unit }}</p></td>{% endif %}
    {% if content.relative %}<td><p class="l">{{ content.relative.label }}</p><p class="n">{{ content.relative.delta }}</p><p class="sub">{{ content.relative.first }} → {{ content.relative.last }}{{ content.relative.unit }}</p></td>{% endif %}
  </tr></table>
  <p class="fine">{{ content.arm_footnote }}</p>
  {% endif %}
  {% if content.rom_rows %}
  <p class="kicker">ROM</p>
  <h2>{{ content.rom_headline }}</h2>
  <table class="grid">
    <tr><th>동작</th><th>이전</th><th>이후</th><th>변화</th></tr>
    {% for row in content.rom_rows %}
    <tr><td>{{ row.motion }}<div class="fine">{{ row.desc }}</div></td><td>{{ row.before }}{{ row.unit }}</td><td>{{ row.after }}{{ row.unit }}</td><td class="delta">{{ row.delta }}</td></tr>
    {% endfor %}
  </table>
  <div class="warm"><p>{{ content.rom_detail }}</p></div>
  <p class="fine">{{ content.rom_footnote }}</p>
  {% endif %}
  <p class="fine">{{ content.other_cancer_note }}</p>
</section>

{% elif section.id == "next_steps" %}
<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">NEXT</p>
  <h2>다음 단계</h2>
  <p class="fine">{{ content.next_date }}</p>
  <table class="cols">
    <tr>
      <td><p class="kicker">유지할 것</p>{{ lines(content.next_keep) }}</td>
      <td><p class="kicker">관찰할 것</p>{{ lines(content.next_watch) }}</td>
      <td><p class="kicker">의료진에게 확인할 것</p>{{ lines(content.next_ask) }}</td>
    </tr>
  </table>
  <div class="nurse">
    <p class="who">{{ txt(content.nurse_author, section.show_blank) }}</p>
    <p>{{ txt(content.nurse_text, section.show_blank) }}</p>
  </div>
  <p class="fine">{{ content.closing }}</p>
</section>
{% endif %}
{% endfor %}

<section class="page">
  <table class="top"><tr><td>{{ document.brand }}</td><td class="right">{{ document.running_title }}</td></tr></table>
  <p class="kicker">LOG</p>
  <h2>생성 정보</h2>
  <p>노란 입력칸 {{ filled_count }}/{{ total_count }}개가 채워져 있습니다.</p>
  {% if omitted %}
  <ul>{% for item in omitted %}<li>생략 · {{ item.title }} — {{ item.reason }}</li>{% endfor %}</ul>
  {% else %}<p>생략된 섹션은 없습니다.</p>{% endif %}
  <p class="fine">로직 {{ version }} · 수정일 {{ updated_at }} · 생성 {{ generated_at }} · {{ source_name }}</p>
  <p class="fine">{{ document.footer_note }}</p>
</section>
<script>
(function () {
  function fits(sheet) {
    if (sheet.clientHeight < 50) return true;
    return sheet.scrollHeight <= sheet.clientHeight + 1;
  }
  function isHeader(node) {
    return node.nodeType === 1 && (node.classList.contains("run") || node.classList.contains("top"));
  }
  function makeNext(sheet, header) {
    if (document.querySelectorAll(".cover, .page").length > 60) return null;
    var next = sheet.cloneNode(false);
    sheet.parentNode.insertBefore(next, sheet.nextSibling);
    if (header) next.appendChild(header.cloneNode(true));
    return next;
  }
  function scaleToFit(sheet, node) {
    var style = getComputedStyle(sheet);
    var room = sheet.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
    Array.prototype.forEach.call(sheet.children, function (el) { if (el !== node) room -= el.offsetHeight; });
    if (room > 0 && node.scrollHeight > room) node.style.zoom = String(room / node.scrollHeight);
  }
  function splitTable(sheet, table, header) {
    var rows = Array.prototype.slice.call(table.rows);
    sheet.removeChild(table);
    var current = sheet;
    var working = table.cloneNode(false);
    current.appendChild(working);
    rows.forEach(function (row) {
      working.appendChild(row);
      if (fits(current)) return;
      if (working.rows.length > 1) {
        working.removeChild(row);
        current = makeNext(current, header);
        working = table.cloneNode(false);
        current.appendChild(working);
        working.appendChild(row);
      }
      if (!fits(current)) scaleToFit(current, working);
    });
    return current;
  }
  function appendNode(sheet, node, header) {
    sheet.appendChild(node);
    if (fits(sheet) || node.nodeType !== 1) return sheet;
    var blocks = Array.prototype.filter.call(sheet.children, function (el) { return !isHeader(el); });
    if (blocks.length > 1) {
      sheet.removeChild(node);
      var next = makeNext(sheet, header);
      if (!next) { sheet.appendChild(node); scaleToFit(sheet, node); return sheet; }
      return appendNode(next, node, header);
    }
    if (node.tagName === "TABLE" && node.rows.length > 1) return splitTable(sheet, node, header);
    if (node.children.length > 1) {
      var kids = Array.prototype.slice.call(node.children);
      sheet.removeChild(node);
      var current = sheet;
      var holder = node.cloneNode(false);
      current.appendChild(holder);
      kids.forEach(function (kid) {
        holder.appendChild(kid);
        if (fits(current) || holder.children.length === 1) return;
        holder.removeChild(kid);
        current = makeNext(current, header);
        holder = node.cloneNode(false);
        current.appendChild(holder);
        holder.appendChild(kid);
      });
      if (!fits(current)) scaleToFit(current, holder);
      return current;
    }
    scaleToFit(sheet, node);
    return sheet;
  }
  function paginate() {
    if (document.body.dataset.paged) return;
    document.body.dataset.paged = "1";
    var originals = Array.prototype.slice.call(document.querySelectorAll(".cover, .page"));
    originals.forEach(function (sheet) {
      var nodes = Array.prototype.slice.call(sheet.childNodes);
      var header = null;
      nodes.forEach(function (node) { sheet.removeChild(node); if (!header && isHeader(node)) header = node; });
      var current = sheet;
      nodes.forEach(function (node) { current = appendNode(current, node, header); });
    });
    var all = document.querySelectorAll(".cover, .page");
    var brand = document.body.dataset.brand || "";
    var note = document.body.dataset.note || "";
    var version = document.body.dataset.version || "";
    Array.prototype.forEach.call(all, function (el, index) {
      var foot = document.createElement("div");
      foot.className = "sheet-foot";
      var pageNo = (index + 1) + " / " + all.length;
      foot.textContent = el.classList.contains("cover")
        ? (document.body.dataset.coverFoot || "")
        : [brand, note, version ? ("로직 " + version) : "", pageNo].filter(Boolean).join("  ·  ");
      el.appendChild(foot);
    });
  }
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll(".cover, .page").forEach(function (el) { el.style.zoom = "1"; });
  });
  function start() { if (document.fonts && document.fonts.ready) document.fonts.ready.then(paginate); else paginate(); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
  else start();
})();
</script>
</body>
</html>
