<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<title>{{ document.title }}</title>
<style>
@font-face { font-family: "ReportKR"; src: url("assets/fonts/NotoSansKR-Regular.woff2") format("woff2"); font-weight: 400; }
@font-face { font-family: "ReportKR"; src: url("assets/fonts/NotoSansKR-Bold.woff2") format("woff2"); font-weight: 700; }
@page {
  size: A4;
  margin: 13mm 14mm 14mm 14mm;
  background: #f0f0e8;
  @bottom-left {
    content: "{{ document.footer_note }}";
    font-family: "ReportKR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; font-size: 8pt; color: #6d7874;
  }
  @bottom-right {
    content: counter(page);
    font-family: "ReportKR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; font-size: 8pt; color: #6d7874;
  }
}
@page cover {
  margin: 16mm 16mm 14mm 16mm;
  background: #103840;
  @bottom-left {
    content: "{{ document.footer_note }}";
    font-family: "ReportKR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; font-size: 8pt; color: #8aa4a8;
  }
  @bottom-right {
    content: counter(page);
    font-family: "ReportKR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; font-size: 8pt; color: #8aa4a8;
  }
}
* { box-sizing: border-box; }
body { margin: 0; font-family: "ReportKR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; color: #183038; font-size: 10pt; line-height: 1.55; background: #f0f0e8; }
.cover { page: cover; color: #f4f1ea; min-height: 250mm; }
.sheet-foot { display: none; }
@media print {
  .sheet-inner { zoom: 1 !important; }
  .sheet-foot { display: none !important; }
}
@media screen {
  body { background: #d9d4c8; margin: 0; padding: 8mm 0 12mm; min-width: 210mm; }
  .cover, .page {
    width: 210mm;
    height: 297mm;
    min-height: 297mm;
    max-height: 297mm;
    margin: 8mm auto 0;
    overflow: hidden;
    position: relative;
    box-shadow: 0 8px 22px rgba(24, 40, 48, 0.14);
    break-before: auto;
  }
  .cover { background: #103840; padding: 16mm 16mm 16mm; }
  .page { background: #f0f0e8; padding: 13mm 14mm 16mm; }
  .sheet-foot {
    display: block;
    position: absolute;
    left: 14mm;
    right: 14mm;
    bottom: 6mm;
    font-size: 8pt;
    color: #6d7874;
  }
  .cover .sheet-foot { color: #8aa4a8; }
}
.brand { margin: 0; letter-spacing: 0.18em; font-size: 10pt; color: #d7e4e2; }
.cover h1 { margin: 22mm 0 0; font-size: 26pt; line-height: 1.28; font-weight: 700; }
.rule { width: 28mm; height: 2px; background: #a84838; margin: 7mm 0; }
.who { margin: 0; font-size: 16pt; }
.meta { margin: 2mm 0 0; color: #c5d5d2; font-size: 11pt; }
.facts { width: 100%; margin-top: 14mm; border-collapse: separate; border-spacing: 3mm 0; margin-left: -3mm; }
.facts td { background: #214850; border-radius: 8px; padding: 3.5mm; width: 33%; vertical-align: top; }
.facts .k { margin: 0; color: #b7c6c4; font-size: 8pt; }
.facts .v { margin: 1mm 0 0; font-size: 12pt; font-weight: 700; color: #f4f1ea; }
.page { break-before: page; }
.top { width: 100%; border-bottom: 0.6pt solid #d5d3c8; padding-bottom: 1.5mm; margin-bottom: 3.5mm; }
.top td { font-size: 8pt; color: #5e6c68; }
.top .right { text-align: right; }
h2 { margin: 1mm 0 2mm; font-size: 13pt; line-height: 1.25; color: #143840; }
.h3 { margin: 3mm 0 1.5mm; font-size: 11pt; color: #143840; }
.timeline { width: 100%; border-collapse: collapse; margin: 0 0 3mm; }
.timeline td { text-align: center; width: 16%; font-size: 8pt; color: #5c6a66; border-top: 1.5px solid #c8c4b8; padding-top: 2mm; }
.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #1d4f4c; margin-top: -6.5mm; }
.timeline .current .dot { background: #a84838; }
.timeline .upcoming .dot { background: #f0f0e8; border: 1.5px solid #8a8175; }
.cards { width: 100%; border-collapse: separate; border-spacing: 2mm 0; margin: 0 0 2mm -2mm; }
.cards td { background: #fff; border-top: 3px solid #1d4f4c; padding: 2mm 2.5mm; vertical-align: top; }
.n { margin: 0; font-size: 12pt; font-weight: 700; color: #143840; }
.l { margin: 0.5mm 0 0; font-size: 8pt; color: #5c6a66; }
.sub { margin: 0; font-size: 7.5pt; color: #6a7672; }
.note { background: #e5f0ea; padding: 2.5mm 3mm; margin: 0 0 2.5mm; font-size: 8.5pt; }
.warm { background: #f6e6dc; padding: 2.5mm 3mm; margin: 0 0 2.5mm; font-size: 8.5pt; }
.groups { width: 100%; border-collapse: separate; border-spacing: 2mm 0; margin: 0 0 2mm -2mm; }
.groups td { background: #fff; padding: 2mm 2.5mm; vertical-align: top; width: 33%; }
.groups h3 { margin: 0 0 1mm; font-size: 9pt; color: #a84838; }
.groups p { margin: 0 0 1mm; font-size: 8pt; }
.pair-grid { width: 100%; border-collapse: separate; border-spacing: 2.5mm 2.5mm; margin-left: -2.5mm; }
.pair-grid td { width: 50%; background: #fff; vertical-align: top; padding: 2.5mm 3mm; border-radius: 8px; }
.session h3 { margin: 1mm 0; font-size: 9.5pt; line-height: 1.35; }
.tag { display: inline-block; background: #103840; color: #f4f1ea; font-size: 7.5pt; padding: 0 1.5mm; margin-right: 1mm; }
.chip { display: inline-block; padding: 0 1.8mm; margin-right: 1.5mm; font-size: 7.5pt; border-radius: 8px; }
.chip.nutrition { background: #d7ebe4; color: #1d4f4c; }
.chip.psych { background: #e4dced; color: #5a4678; }
.cap { width: 100%; border-collapse: collapse; margin: 0 0 1.2mm; background: #fff; }
.cap td { padding: 1.1mm 2.2mm; vertical-align: top; font-size: 8pt; line-height: 1.32; }
.cap .name { font-weight: 700; }
.before { background: #f4f1ea; width: 50%; }
.after { background: #d8e8e0; width: 50%; }
.grid { width: 100%; border-collapse: collapse; background: #fff; margin: 0 0 2mm; }
.grid th, .grid td { border-bottom: 0.4pt solid #e0ddd2; text-align: left; padding: 1.4mm 2mm; vertical-align: top; font-size: 8pt; }
.grid th { color: #6a7672; font-weight: 400; }
.delta { color: #a84838; font-weight: 700; }
.cols td { width: 33%; background: #fff; vertical-align: top; padding: 2.5mm; border-top: 3px solid #a84838; }
.cols { width: 100%; border-collapse: separate; border-spacing: 2mm 0; margin-left: -2mm; }
.cols h3 { margin: 0; font-size: 9pt; color: #a84838; }
.cols ul { margin: 1.5mm 0 0; padding-left: 4mm; font-size: 8pt; }
.nurse { background: #103840; color: #f4f1ea; padding: 3.5mm; margin-top: 3mm; }
.nurse .who { font-size: 11pt; margin: 0 0 1.5mm; }
.missing { color: #8a8175; }
.fine { color: #5c6a66; font-size: 8pt; margin: 0 0 2mm; }
.rowhead { width: 100%; }
.rowhead td { vertical-align: bottom; }
.badge { text-align: right; color: #a84838; font-size: 8pt; font-weight: 700; }
</style>
</head>
<body data-brand="{{ document.brand }}" data-note="{{ document.footer_note }}" data-cover-foot="{{ document.footer_note }}">
{% macro txt(value, blank) -%}
{%- if value -%}{{ value }}{%- elif blank -%}<span class="missing">{{ content.missing_text }}</span>{%- endif -%}
{%- endmacro %}
{% macro lines(value) -%}
<ul>{% for line in (value or "").split("\n") if line.strip() %}<li>{{ line.strip() }}</li>{% endfor %}</ul>
{%- endmacro %}

{% for section in sections %}
{% if section.id == "cover" %}
<header class="cover">
  <p class="brand">{{ document.brand }}</p>
  <h1>{{ document.title }}</h1>
  <div class="rule"></div>
  <p class="who">{{ txt(content.name, section.show_blank) }}</p>
  <p class="meta">{{ txt(content.cancer_type, section.show_blank) }}</p>
  <table class="facts"><tr>
    <td><p class="k">관리 기간</p><p class="v">{{ txt(content.date_range, section.show_blank) }}</p></td>
    <td><p class="k">총 방문</p><p class="v">{{ txt(content.visit_count, true) }}</p></td>
    <td><p class="k">발행일</p><p class="v">{{ txt(content.issued_on, section.show_blank) }}</p></td>
  </tr></table>
</header>

{% elif section.id == "summary" %}
<section class="page">
  <table class="top"><tr><td>02 · 요약</td><td class="right">{{ document.running_title }}</td></tr></table>
  <table class="timeline"><tr>
    {% for visit in content.visits %}
    <td class="{{ visit.status }}"><span class="dot"></span><br/>{{ visit.no }}차<br/>{{ visit.date }}</td>
    {% endfor %}
  </tr></table>
  <h2>① 이런 변화가 있었어요</h2>
  <table class="cards"><tr>
    {% for stat in content.summary_stats %}
    <td><p class="n">{{ txt(stat.value, section.show_blank) }}</p><p class="l">{{ stat.label }}</p><p class="sub">{{ stat.sub }}</p></td>
    {% endfor %}
  </tr></table>
  <div class="note">{{ txt(content.summary_narrative, section.show_blank) }}</div>
  <h2>② 이렇게 실천했어요</h2>
  <table class="groups"><tr>
    {% for group in practice_groups %}
    <td>
      <h3>{{ group.name }}</h3>
      {% for item in group["items"] %}<p><strong>{{ txt(item.value, section.show_blank) }}</strong> {{ item.label }}</p>{% endfor %}
    </td>
    {% endfor %}
  </tr></table>
  <div class="note">{{ txt(content.practice_narrative, section.show_blank) }}</div>
  <h2>③ 이렇게 관리해드렸어요</h2>
  <table class="cards"><tr>
    {% for stat in content.care_stats %}
    <td><p class="n">{{ txt(stat.value, section.show_blank) }}</p><p class="l">{{ stat.label }}</p></td>
    {% endfor %}
    {% if content.call_count %}<td><p class="n">{{ content.call_count }}회</p><p class="l">담당자 소통</p></td>{% endif %}
  </tr></table>
  <div class="warm">{{ txt(content.care_narrative, section.show_blank) }}</div>
  {% if content.professor %}<div class="note">{{ content.professor }}</div>{% endif %}
  {% if content.next_plan %}<p class="fine">{{ content.next_plan }}</p>{% endif %}
  {% if content.next_chips %}<p>{% for chip in content.next_chips.split("\n") if chip.strip() %}<span class="chip nutrition">{{ chip.strip() }}</span>{% endfor %}</p>{% endif %}
</section>

{% elif section.id == "sessions" %}
<section class="page">
  <table class="top"><tr><td>03 · 회차별 실천 기록</td><td class="right">{{ document.running_title }}</td></tr></table>
  <h2>회차별 실천 기록</h2>
  <table class="pair-grid">
  {% for row in content.sessions %}
    {% if loop.index0 % 2 == 0 %}<tr>{% endif %}
    <td class="session">
      <p class="fine">{{ row.no }}회차 · {{ row.date }} {% if row.tag %}<span class="tag">{{ tag_labels.get(row.tag, row.tag) }}</span>{% endif %}</p>
      <h3>{{ txt(row.title, section.show_blank) }}</h3>
      <p>{{ txt(row.desc, section.show_blank) }}</p>
      {% if row.note_text %}<p><span class="chip {{ row.note_type }}">{{ note_labels.get(row.note_type, row.note_type or "메모") }}</span>{{ row.note_text }}</p>{% endif %}
    </td>
    {% if loop.index % 2 == 0 or loop.last %}{% if loop.index % 2 == 1 %}<td></td>{% endif %}</tr>{% endif %}
  {% endfor %}
  </table>
  <p class="fine">{{ content.session_note }}</p>
</section>

{% elif section.id == "capability" %}
<section class="page">
  <table class="top"><tr><td>04 · 운동별 체력 변화</td><td class="right">{{ document.running_title }}</td></tr></table>
  <h2>운동별 체력 변화</h2>
  {% for row in content.capabilities %}
  <table class="cap">
    <tr><td colspan="2"><strong>{{ row.name }}</strong></td></tr>
    <tr>
      <td class="before"><p class="l">이전</p><p>{{ txt(row.before, section.show_blank) }}</p></td>
      <td class="after"><p class="l">이후</p><p>{{ txt(row.after, section.show_blank) }}</p></td>
    </tr>
    {% if row.note %}<tr><td colspan="2">{{ row.note }}</td></tr>{% endif %}
  </table>
  {% endfor %}
  {% if content.capability_quote %}<div class="warm"><p>{{ content.capability_quote }}</p></div>{% endif %}
</section>

{% elif section.id == "functional" %}
<section class="page">
  <table class="top"><tr><td>05 · 수행 지표로 확인한 변화</td><td class="right">{{ document.running_title }}</td></tr></table>
  <h2>수행 지표로 확인한 변화</h2>
  <table class="rowhead"><tr><td><p class="h3">이번 3개월 동안 익힌 운동</p></td><td class="badge">{{ content.learned_badge }}</td></tr></table>
  {% if content.learned %}
  <table class="cards"><tr>
    {% for row in content.learned %}<td><p class="n">{{ row.label }}</p><p class="l">{{ row.range }}</p></td>{% endfor %}
  </tr></table>
  {% elif section.show_blank %}<p class="missing">{{ content.missing_text }}</p>{% endif %}
  <table class="rowhead"><tr><td><p class="h3">SPPB {{ content.sppb_total }}</p></td><td class="badge">{{ content.sppb_badge }}</td></tr></table>
  {% if content.sppb_headline %}<p class="n">{{ content.sppb_headline }}</p>{% endif %}
  <table class="grid">
    <tr><th>항목</th><th>첫 검사</th><th>재검사</th><th>점수</th><th>메모</th></tr>
    {% for row in content.sppb %}
    <tr><td>{{ row.label }}<div class="fine">{{ row.caption }}</div></td><td>{{ row.first }}{{ row.unit }}</td><td>{{ row.last }}{{ row.unit }}</td><td>{{ row.score_first }} → {{ row.score_last }}</td><td>{{ row.note }}</td></tr>
    {% endfor %}
  </table>
  <div class="note">{{ content.sppb_detail }}</div>
  <p class="h3">체중 · BMI</p>
  {% if content.weight %}
  <p class="n">{{ content.weight.first }}{{ content.weight.unit }} → {{ content.weight.last }}{{ content.weight.unit }} <span class="delta">{{ content.weight.delta }}</span></p>
  {% elif section.show_blank %}<p class="missing">{{ content.missing_text }}</p>{% endif %}
  <p class="fine">{{ content.weight_note }}</p>
  <p class="fine">BMI {{ content.bmi_text }} · 참고정보</p>
</section>

{% elif section.id == "cancer" %}
<section class="page">
  <table class="top"><tr><td>06 · 암종별 특화 지표</td><td class="right">{{ content.cancer_type_metric or content.cancer_type }}</td></tr></table>
  <h2>암종별 특화 지표</h2>
  {% if content.arm_rows %}
  <table class="rowhead"><tr><td><p class="h3">① 환측 팔둘레 추이</p></td><td class="badge">{{ content.arm_delta }} · {{ content.arm_badge }}</td></tr></table>
  <div class="note">{{ content.arm_svg | safe }}</div>
  <div class="warm">{{ content.arm_interp }}</div>
  <table class="cards"><tr>
    {% if content.volume %}<td><p class="l">{{ content.volume.label.split(" (")[0] }}</p><p class="n">{{ content.volume.delta }}</p><p class="sub">{{ content.volume.first }} → {{ content.volume.last }} {{ content.volume.unit }}</p></td>{% endif %}
    {% if content.relative %}<td><p class="l">{{ content.relative.label.split(" (")[0] }}</p><p class="n">{{ content.relative.delta }}</p><p class="sub">{{ content.relative.first }} → {{ content.relative.last }}{{ content.relative.unit }}</p></td>{% endif %}
  </tr></table>
  <p class="fine">{{ content.arm_footnote }}</p>
  {% endif %}
  {% if content.rom_rows %}
  <p class="h3">② 어깨 관절가동범위(ROM)</p>
  <p class="n">{{ content.rom_headline }}</p>
  <table class="grid">
    <tr><th>동작</th><th>이전</th><th>이후</th><th>변화</th></tr>
    {% for row in content.rom_rows %}
    <tr><td>{{ row.motion }}<div class="fine">{{ row.desc }}</div></td><td>{{ row.before }}{{ row.unit }}</td><td>{{ row.after }}{{ row.unit }}</td><td class="delta">{{ row.delta }}</td></tr>
    {% endfor %}
  </table>
  <div class="warm">{{ content.rom_detail }}</div>
  <p class="fine">{{ content.rom_footnote }}</p>
  {% endif %}
  <p class="fine">{{ content.other_cancer_note }}</p>
</section>

{% elif section.id == "next_steps" %}
<section class="page">
  <table class="top"><tr><td>07 · 다음 3개월을 위한 제안</td><td class="right">{{ document.running_title }}</td></tr></table>
  <h2>다음 3개월을 위한 제안</h2>
  <p class="fine">{{ content.next_date }}</p>
  <table class="cols">
    <tr>
      <td><h3>유지할 것</h3>{{ lines(content.next_keep) }}</td>
      <td><h3>관찰할 것</h3>{{ lines(content.next_watch) }}</td>
      <td><h3>의료진에게 확인할 것</h3>{{ lines(content.next_ask) }}</td>
    </tr>
  </table>
  <div class="nurse">
    <p class="who">{{ txt(content.nurse_author, section.show_blank) }}</p>
    <p>{{ txt(content.nurse_text, section.show_blank) }}</p>
  </div>
  <p class="fine">{{ content.closing }}</p>
</section>
{% endif %}
{% endfor %}
<script>
(function () {
  function fits(sheet) {
    if (sheet.clientHeight < 50) return true;
    return sheet.scrollHeight <= sheet.clientHeight + 1;
  }
  function isHeader(node) {
    return node.nodeType === 1 && (node.classList.contains("run") || node.classList.contains("top"));
  }
  function makeNext(sheet, header) {
    if (document.querySelectorAll(".cover, .page").length > 60) return null;
    var next = sheet.cloneNode(false);
    sheet.parentNode.insertBefore(next, sheet.nextSibling);
    if (header) next.appendChild(header.cloneNode(true));
    return next;
  }
  function scaleToFit(sheet, node) {
    var style = getComputedStyle(sheet);
    var room = sheet.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
    Array.prototype.forEach.call(sheet.children, function (el) { if (el !== node) room -= el.offsetHeight; });
    if (room > 0 && node.scrollHeight > room) node.style.zoom = String(room / node.scrollHeight);
  }
  function splitTable(sheet, table, header) {
    var rows = Array.prototype.slice.call(table.rows);
    sheet.removeChild(table);
    var current = sheet;
    var working = table.cloneNode(false);
    current.appendChild(working);
    rows.forEach(function (row) {
      working.appendChild(row);
      if (fits(current)) return;
      if (working.rows.length > 1) {
        working.removeChild(row);
        current = makeNext(current, header);
        working = table.cloneNode(false);
        current.appendChild(working);
        working.appendChild(row);
      }
      if (!fits(current)) scaleToFit(current, working);
    });
    return current;
  }
  function appendNode(sheet, node, header) {
    sheet.appendChild(node);
    if (fits(sheet) || node.nodeType !== 1) return sheet;
    var blocks = Array.prototype.filter.call(sheet.children, function (el) { return !isHeader(el); });
    if (blocks.length > 1) {
      sheet.removeChild(node);
      var next = makeNext(sheet, header);
      if (!next) { sheet.appendChild(node); scaleToFit(sheet, node); return sheet; }
      return appendNode(next, node, header);
    }
    if (node.tagName === "TABLE" && node.rows.length > 1) return splitTable(sheet, node, header);
    if (node.children.length > 1) {
      var kids = Array.prototype.slice.call(node.children);
      sheet.removeChild(node);
      var current = sheet;
      var holder = node.cloneNode(false);
      current.appendChild(holder);
      kids.forEach(function (kid) {
        holder.appendChild(kid);
        if (fits(current) || holder.children.length === 1) return;
        holder.removeChild(kid);
        current = makeNext(current, header);
        holder = node.cloneNode(false);
        current.appendChild(holder);
        holder.appendChild(kid);
      });
      if (!fits(current)) scaleToFit(current, holder);
      return current;
    }
    scaleToFit(sheet, node);
    return sheet;
  }
  function paginate() {
    if (document.body.dataset.paged) return;
    document.body.dataset.paged = "1";
    var originals = Array.prototype.slice.call(document.querySelectorAll(".cover, .page"));
    originals.forEach(function (sheet) {
      var nodes = Array.prototype.slice.call(sheet.childNodes);
      var header = null;
      nodes.forEach(function (node) { sheet.removeChild(node); if (!header && isHeader(node)) header = node; });
      var current = sheet;
      nodes.forEach(function (node) { current = appendNode(current, node, header); });
    });
    var all = document.querySelectorAll(".cover, .page");
    var brand = document.body.dataset.brand || "";
    var note = document.body.dataset.note || "";
    var version = document.body.dataset.version || "";
    Array.prototype.forEach.call(all, function (el, index) {
      var foot = document.createElement("div");
      foot.className = "sheet-foot";
      var pageNo = (index + 1) + " / " + all.length;
      foot.textContent = el.classList.contains("cover")
        ? (document.body.dataset.coverFoot || "")
        : [brand, note, version ? ("로직 " + version) : "", pageNo].filter(Boolean).join("  ·  ");
      el.appendChild(foot);
    });
  }
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll(".cover, .page").forEach(function (el) { el.style.zoom = "1"; });
  });
  function start() { if (document.fonts && document.fonts.ready) document.fonts.ready.then(paginate); else paginate(); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
  else start();
})();
</script>
</body>
</html>
